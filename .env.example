# =============================================================================
# semelpass-oss — .env.example
# Copy to .env and fill in all values marked REQUIRED or GENERATE
# Run setup.sh for interactive setup (recommended)
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production                        # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
BASE_URL=https://your-domain.com          # REQUIRED — your public domain
APP_VERSION=26.05.1.0
ALLOWED_ORIGINS=https://your-domain.com   # REQUIRED — comma-separated

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=semelpass                     # REQUIRED
POSTGRES_USER=semelpass                   # REQUIRED
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD  # REQUIRED — min 32 chars

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD  # REQUIRED — min 32 chars

# ── JWT ───────────────────────────────────────────────────────────────────────
# GENERATE: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=GENERATE_64_HEX_CHARS         # REQUIRED
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ── Encryption ────────────────────────────────────────────────────────────────
# GENERATE: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=GENERATE_FERNET_KEY           # REQUIRED

# ── HMAC ──────────────────────────────────────────────────────────────────────
# GENERATE: python3 -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET=GENERATE_64_HEX_CHARS        # REQUIRED

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_FROM=welcome@your-domain.com        # REQUIRED
MAIL_FROM_NAME=semelpass
SMTP_HOST=semelpass-postfix              # internal container name
SMTP_PORT=25

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
MAGIC_LINK_EXPIRE_MINUTES=15

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_BUCKET_CAPACITY=10
RATE_REFILL_SECONDS=20

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@your-domain.com        # REQUIRED — your admin email

# ── Juice Shop Demo (optional — remove block if not using demo) ───────────────
JUICE_DEMO_EMAIL=admin@juice-sh.op
JUICE_DEMO_PASSWORD=admin123

# ── Stripe (optional — required only for commercial billing) ──────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...            # or sk_test_... for sandbox
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SEMELPASS_PRODUCT_ID=prod_...

# Self-hosted commercial license prices (from Stripe dashboard)
STRIPE_PRICE_SELF_HOSTED_MONTHLY=price_...
STRIPE_PRICE_SELF_HOSTED_ANNUAL=price_...
STRIPE_PRICE_SELF_HOSTED_2YEAR=price_...
STRIPE_PRICE_SELF_HOSTED_3YEAR=price_...

# Managed hosting prices
STRIPE_PRICE_MANAGED_MONTHLY=price_...
STRIPE_PRICE_MANAGED_ANNUAL=price_...
STRIPE_PRICE_MANAGED_2YEAR=price_...
STRIPE_PRICE_MANAGED_3YEAR=price_...
